<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!-- 继承微服务父工程 -->
    <parent>
        <groupId>com.jwy</groupId>
        <artifactId>springcloud-demo</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- 默认 packaging=jar：执行 package 会产出可执行 fat jar -->
    <artifactId>service-gateway</artifactId>
    <name>service-gateway</name>
    <description>API 网关：统一对外入口，按路径把请求路由到 service-system / service-auth</description>

    <dependencies>
        <!-- Web（Servlet/Tomcat）：与 service-system / service-auth 保持一致的运行模型 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            Spring Cloud Gateway（Spring Boot 4 专用，servlet / webmvc 风味）。
            注意 Boot 4 下网关 starter 已改名（旧名 spring-cloud-starter-gateway 在 Boot 4 已失效）：
              - 响应式(Netty): spring-cloud-starter-gateway-server-webflux
              - Servlet(Tomcat): spring-cloud-starter-gateway-server-webmvc   （本项目选用，与现有服务一致）
            路由配置根为 spring.cloud.gateway.server.webmvc.routes（不再是 spring.cloud.gateway.routes）。
            版本由父 BOM（spring-cloud-dependencies:2025.1.0 → 5.0.x 线）统一管理，不手写版本号。
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webmvc</artifactId>
        </dependency>

        <!-- 负载均衡：配合网关路由 uri: lb://<服务名> 做服务发现后的实例选择（lb:// 必需） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!-- Nacos 服务注册与发现：网关本身注册到 Nacos，并从 Nacos 发现各后端服务 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <!-- ★ Redis：网关鉴权的唯一依赖来源（Redis Session Token 方案）。
             鉴权过滤器直接读 service-auth 登录时写入的会话（rxs:6379 / db 2），
             查得到即令牌有效，并从中取出 userId / username 透传给下游。
             注意：这里【没有】openfeign、也没有 service-auth-api 的 Feign 客户端 ——
             网关不需要知道「怎么调认证服务」，只需要知道「会话存在哪个 Redis key 上」。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- ★ 认证契约模块：这里只为了拿到 AuthSession / AuthSessionKeys / AuthHeaders 这几个
             「跨进程共享的常量与数据模型」。它不引入任何 Feign 运行时（api 模块里 openfeign 是 optional），
             所以网关仍然是「零服务间调用」的。 -->
        <dependency>
            <groupId>com.jwy</groupId>
            <artifactId>service-auth-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 测试：过滤器单测（MockHttpServletRequest / Mockito / JUnit） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 启用 Spring Boot repackage，产出可执行 jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- 继承父工程 pluginManagement 中预置的 lombok 注解处理器路径 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
