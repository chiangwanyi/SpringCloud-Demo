<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- 继承 Spring Boot 父 POM，统一依赖与插件版本 -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.8</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<!-- 微服务聚合/父工程：packaging=pom，自身不产出 jar -->
	<groupId>com.jwy</groupId>
	<artifactId>springcloud-demo</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>springcloud-demo</name>
	<description>Spring Cloud 微服务父工程（聚合工程，不打包 jar）</description>

	<properties>
		<java.version>21</java.version>
	</properties>

	<!-- 子模块清单：每个子模块都可作为独立微服务，执行 package 产出可执行 jar -->
	<modules>
		<module>service-system</module>
		<module>service-system-api</module>
		<module>service-auth</module>
		<module>service-auth-api</module>
		<module>service-order</module>
		<module>service-order-api</module>
		<module>service-gateway</module>
	</modules>

	<!--
		父工程只做统一版本管理，不引入具体依赖；
		依赖由各子模块自行声明（可借助 dependencyManagement 统一版本）。
	-->
	<dependencyManagement>
		<dependencies>
			<!--
				注意：此处刻意不管理 MyBatis-Plus 的版本。
				各实现模块统一使用 Spring Boot 4 专用启动器
				`com.baomidou:mybatis-plus-spring-boot4-starter`（并在模块内显式写版本），
				不要使用 `mybatis-plus-boot-starter`——后者会传递引入 mybatis-spring 3.x，
				与 Spring Framework 7 的 factoryBeanObjectType 冲突，报 Invalid bean definition。
			-->

			<!--
				Spring Cloud Alibaba BOM（统一管理 Nacos 客户端等版本）。
				2025.1.0.0 对应 Spring Cloud 2025.1.x（spring-cloud-* 5.0.x 线），
				与本项目网关 starter 5.0.3（同样属于 2025.1.x / 5.0.x 线）以及 Spring Boot 4.0.8 兼容。
				注意：旧的 2025.0.0.0 属于 spring-cloud 4.3.x 线，编译于 Boot 4.0 里程碑版本，
				在 Boot 4.0.8 GA 上会缺失类（如 WebServerInitializedEvent），必须升级到 2025.1.x。
			-->
			<dependency>
				<groupId>com.alibaba.cloud</groupId>
				<artifactId>spring-cloud-alibaba-dependencies</artifactId>
				<version>2025.1.0.0</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!--
				Spring Cloud BOM（统一管理 commons / context / loadbalancer / gateway 等版本）。
				2025.1.0 对应 Spring Cloud 2025.1.x（spring-cloud-* 5.0.x 线），是 Spring Boot 4.0.8 GA 的兼容线。
				放在 alibaba BOM 之后，使其管理的 spring-cloud-* 版本（5.0.x）优先生效，
				与网关 starter 5.0.3 保持一致，避免被旧的 4.3.x（2025.0.x）线强制降级。
			-->
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>2025.1.0</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<!-- pluginManagement：声明但不直接执行，供子模块按需继承使用 -->
		<pluginManagement>
			<plugins>
				<!-- 子模块引入该插件即可在 package 阶段 repackage 出可执行 fat jar -->
				<plugin>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-maven-plugin</artifactId>
				</plugin>
				<!-- Lombok 注解处理器，供所有子模块共享 -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<configuration>
						<!-- -parameters：保留方法参数名，SpringDoc 生成文档时可直接拿到参数名（Boot 3+ 推荐） -->
						<parameters>true</parameters>
						<annotationProcessorPaths>
							<path>
								<groupId>org.projectlombok</groupId>
								<artifactId>lombok</artifactId>
							</path>
						</annotationProcessorPaths>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

</project>
