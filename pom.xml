<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- 继承 Spring Boot 父 POM，统一依赖与插件版本 -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.8</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<!-- 微服务聚合/父工程：packaging=pom，自身不产出 jar -->
	<groupId>com.jwy</groupId>
	<artifactId>springcloud-demo</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>springcloud-demo</name>
	<description>Spring Cloud 微服务父工程（聚合工程，不打包 jar）</description>

	<properties>
		<java.version>21</java.version>
	</properties>

	<!-- 子模块清单：每个子模块都可作为独立微服务，执行 package 产出可执行 jar -->
	<modules>
		<module>service-system</module>
		<module>service-system-api</module>
		<module>service-auth</module>
		<module>service-auth-api</module>
		<module>service-gateway</module>
	</modules>

	<!--
		父工程只做统一版本管理，不引入具体依赖；
		依赖由各子模块自行声明（可借助 dependencyManagement 统一版本）。
	-->
	<dependencyManagement>
		<dependencies>
			<!-- MyBatis Plus -->
			<dependency>
				<groupId>com.baomidou</groupId>
				<artifactId>mybatis-plus-boot-starter</artifactId>
				<version>3.5.3.1</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<!-- pluginManagement：声明但不直接执行，供子模块按需继承使用 -->
		<pluginManagement>
			<plugins>
				<!-- 子模块引入该插件即可在 package 阶段 repackage 出可执行 fat jar -->
				<plugin>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-maven-plugin</artifactId>
				</plugin>
				<!-- Lombok 注解处理器，供所有子模块共享 -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<configuration>
						<annotationProcessorPaths>
							<path>
								<groupId>org.projectlombok</groupId>
								<artifactId>lombok</artifactId>
							</path>
						</annotationProcessorPaths>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

</project>
