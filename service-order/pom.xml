<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!-- 继承微服务父工程 -->
    <parent>
        <groupId>com.jwy</groupId>
        <artifactId>springcloud-demo</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- 默认 packaging=jar：执行 package 会产出可执行 fat jar -->
    <artifactId>service-order</artifactId>
    <name>service-order</name>
    <description>service-order 订单微服务（下单 / 订单查询 / 商品与库存），通过 Feign 调用 service-system</description>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- MyBatis-Plus（Spring Boot 4 专用启动器，兼容 Spring Framework 7 / Boot 4.0.8） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
            <version>3.5.16</version>
        </dependency>
        <!-- MySQL 数据库驱动：连接真实 MySQL，driver 由 application.yml 指定 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Web 模块：提供 @RestController / Spring MVC 注解，用于暴露 HTTP 接口 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 本模块自身的对外契约（DTO + Feign 接口） -->
        <dependency>
            <groupId>com.jwy</groupId>
            <artifactId>service-order-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- ★ 发号服务的契约：IdGenApi（Feign 接口）+ SegmentBuffer（号段消费组件）。
            本服务是【消费方】而不是实现方，因此启动类上用
            @EnableFeignClients(clients = IdGenApi.class) 精确注册成 Feign 代理
            （绝不能用 basePackages 宽扫描，理由见启动类注释）。 -->
        <dependency>
            <groupId>com.jwy</groupId>
            <artifactId>service-id-gen-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- ★ 被调用方的契约模块：依赖它才能拿到 SysUserApi 接口，从而通过 Feign 远程调用 service-system。
             注意它只是个「接口 + DTO」的轻量 jar，不含 service-system 的任何实现代码。 -->
        <dependency>
            <groupId>com.jwy</groupId>
            <artifactId>service-system-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- ★ OpenFeign：声明式远程调用。启动类需配合 @EnableFeignClients 才会生成客户端代理。
             版本由父 BOM 统一管理（2025.1.0 → 5.0.0），不要手写版本号。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>

        <!-- ★ LoadBalancer：Feign 用「服务名」（service-system）发起调用时，必须靠它从 Nacos
             取出实例列表并做实例选择。openfeign starter 不会自带这个依赖，漏了会报找不到服务。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!-- SpringDoc OpenAPI：自动生成 OpenAPI 3 文档并内置 Swagger UI（3.x 线才兼容 Boot 4） -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.1.1</version>
        </dependency>

        <!-- Nacos 服务注册与发现：本服务启动后自动注册到 Nacos，供网关通过 lb://service-order 发现 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <!-- Nacos 配置中心：从 Nacos 拉取 datasource 等外部化配置（spring.config.import 引入） -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>

        <!-- ★ Sentinel：限流 / 熔断 / 降级。版本由父 BOM（spring-cloud-alibaba-dependencies:2025.1.0.0）
             统一管理（落到 Sentinel 1.8.x），不手写版本号。接入点：
             1) application.yml 配 spring.cloud.sentinel.transport.dashboard 指向控制台；
             2) OrderServiceImpl 用 @SentinelResource + fallback 做跨服务调用的降级。 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 启用 Spring Boot repackage，产出可执行 jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- 继承父工程 pluginManagement 中预置的 lombok 注解处理器路径 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
